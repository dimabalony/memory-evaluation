  "messages": [
    {
      "from": "owner",
      "minute": 0,
      "text": "Le nouveau contrat est signé : je suis apprenti boulanger chez Grain Bleu."
    },
    {
      "from": "third",
      "minute": 3,
      "text": "Félicitations Ivo. Mon cousin Ivo Celik cherche aussi un apprentissage."
    },
    {
      "from": "peer",
      "minute": 6,
      "text": "Deux Ivo dans la même conversation, ça va être pratique."
    },
    {
      "from": "owner",
      "minute": 9,
      "text": "Ton cousin et moi sommes bien deux personnes différentes."
    },
    {
      "from": "third",
      "minute": 12,
      "text": "Lui habite à Rouen; il ne travaille pas encore dans une boulangerie."
    },
    {
      "from": "owner",
      "minute": 15,
      "text": "Le four doit arriver le 28 février 2026."
    },
    {
      "from": "assistant",
      "minute": 18,
      "text": "Apprentissage de Ivo Marin chez Grain Bleu; livraison provisoire le 28 février."
    },
    {
      "from": "peer",
      "minute": 21,
      "text": "Les plaques doivent refroidir avant de les laver."
    },
    {
      "from": "owner",
      "minute": 24,
      "text": "Oui, et ne mouillons pas la balance."
    },
    {
      "from": "third",
      "minute": 27,
      "text": "Je range les sacs de farine loin de la porte."
    },
    {
      "from": "peer",
      "minute": 30,
      "text": "Mara, où est le minuteur de secours?"
    },
    {
      "from": "third",
      "minute": 33,
      "text": "Près du pétrin; je viens de le remettre là."
    },
    {
      "from": "owner",
      "minute": 36,
      "text": "On pourra le tester après la pause."
    },
    {
      "from": "assistant",
      "minute": 39,
      "text": "Le minuteur reste un sujet séparé de la livraison du four."
    },
    {
      "from": "third",
      "minute": 42,
      "text": "Mon cousin Ivo Celik viendra peut-être samedi."
    },
    {
      "from": "peer",
      "minute": 45,
      "text": "Il pourra nous aider à déplacer les cartons."
    },
    {
      "from": "owner",
      "minute": 48,
      "text": "Revenons à mes repas pour la formation."
    },
    {
      "from": "peer",
      "minute": 51,
      "text": "J’allais commander un repas végétalien pour toi, selon les anciennes notes."
    },
    {
      "from": "owner",
      "minute": 54,
      "text": "Non : je ne suis pas végétalien. Je suis intolérant au lactose; la viande me convient."
    },
    {
      "from": "third",
      "minute": 57,
      "text": "Donc on évite le lait pour Ivo Marin, pas tous les produits animaux."
    },
    {
      "from": "owner",
      "minute": 60,
      "text": "Exactement. Ne confondez pas cette restriction avec le régime de ton cousin."
    },
    {
      "from": "peer",
      "minute": 63,
      "text": "Et le petit carnet de commandes?"
    },
    {
      "from": "third",
      "minute": 66,
      "text": "Aujourd’hui seulement il est dans le tiroir rouge, ensuite je le reprends."
    },
    {
      "from": "owner",
      "minute": 69,
      "text": "Merci. As-tu reçu la réponse du transporteur?"
    },
    {
      "from": "third",
      "minute": 72,
      "text": "Oui, la livraison est repoussée au mardi suivant."
    },
    {
      "from": "peer",
      "minute": 75,
      "text": "Le mois change; peux-tu donner une date sans ambiguïté?"
    },
    {
      "from": "third",
      "minute": 78,
      "text": "Le mardi 3 mars 2026, et non le samedi 28 février."
    },
    {
      "from": "owner",
      "minute": 81,
      "text": "D’accord, le 3 mars 2026 est confirmé pour le four."
    },
    {
      "from": "assistant",
      "minute": 84,
      "text": "Je suivrai la date confirmée et la restriction alimentaire explicitement corrigée."
    },
    {
      "from": "peer",
      "minute": 87,
      "text": "On peut clore la liste pour ce soir."
    }
  ],
