  "messages": [
    {
      "from": "owner",
      "minute": 0,
      "text": "Kai, сохрани рабочую новость: я инженер по электронике в мастерской Север."
    },
    {
      "from": "assistant",
      "minute": 3,
      "text": "Понял, Зоя. Как идёт подготовка робота?"
    },
    {
      "from": "owner",
      "minute": 6,
      "text": "Демо пока назначено на 2026-10-04."
    },
    {
      "from": "owner",
      "minute": 9,
      "text": "Моя сестра Зоя Карим помогает с афишей. Да, у нас одинаковые имена."
    },
    {
      "from": "assistant",
      "minute": 12,
      "text": "Не буду смешивать Зою Петров и Зою Карим."
    },
    {
      "from": "owner",
      "minute": 15,
      "text": "Она не инженер. Она работает иллюстратором и только рисует афишу."
    },
    {
      "from": "owner",
      "minute": 18,
      "text": "У меня в команде ещё есть коллега Карим, но это не моя сестра."
    },
    {
      "from": "assistant",
      "minute": 21,
      "text": "У коллеги Карима и сестры Зои Карим разные роли."
    },
    {
      "from": "owner",
      "minute": 24,
      "text": "У робота слетел ремень, сейчас проверяю натяжитель."
    },
    {
      "from": "assistant",
      "minute": 27,
      "text": "Сначала механика; к афише вернёмся позже."
    },
    {
      "from": "owner",
      "minute": 30,
      "text": "Есть запасной ремень, так что задержки не будет."
    },
    {
      "from": "owner",
      "minute": 33,
      "text": "Карим из команды отнёс старый на склад."
    },
    {
      "from": "assistant",
      "minute": 36,
      "text": "Рабочий Карим, не Зоя Карим. Верно?"
    },
    {
      "from": "owner",
      "minute": 39,
      "text": "Да. Кстати, я по-прежнему работаю в Севере; это не смена работодателя."
    },
    {
      "from": "owner",
      "minute": 42,
      "text": "Вернёмся к сестре: она рисует афиши удалённо из Перми."
    },
    {
      "from": "assistant",
      "minute": 45,
      "text": "Сестра Зоя Карим живёт и работает в Перми?"
    },
    {
      "from": "owner",
      "minute": 48,
      "text": "Да, теперь она живёт в Перми, не в Уфе. Переехала в августе."
    },
    {
      "from": "owner",
      "minute": 51,
      "text": "Её иллюстраторская работа от переезда не изменилась."
    },
    {
      "from": "assistant",
      "minute": 54,
      "text": "Иллюстратор, Пермь; не инженер и не коллега Карим."
    },
    {
      "from": "owner",
      "minute": 57,
      "text": "На сегодня всё про семейные новости."
    },
    {
      "from": "owner",
      "minute": 60,
      "text": "Для сегодняшней сборки сервопривод лежит в оранжевом ланчбоксе."
    },
    {
      "from": "assistant",
      "minute": 63,
      "text": "Временное место для сегодняшней сборки."
    },
    {
      "from": "owner",
      "minute": 66,
      "text": "После сборки верну его в ящик деталей."
    },
    {
      "from": "owner",
      "minute": 69,
      "text": "А теперь снова про демо."
    },
    {
      "from": "assistant",
      "minute": 72,
      "text": "Что изменилось в бронировании?"
    },
    {
      "from": "owner",
      "minute": 75,
      "text": "Организаторы дали зал только на неделю позже."
    },
    {
      "from": "owner",
      "minute": 78,
      "text": "Подтверждённая дата 2026-10-11. Четвёртое октября отменено."
    },
    {
      "from": "assistant",
      "minute": 81,
      "text": "Новое подтверждение важнее первоначальной даты."
    },
    {
      "from": "owner",
      "minute": 84,
      "text": "Пожалуйста, не перепутай семейную афишу и рабочую демонстрацию."
    },
    {
      "from": "assistant",
      "minute": 87,
      "text": "Разделю эти два контекста."
    },
    {
      "from": "owner",
      "minute": 90,
      "text": "Никаких других новых фактов; заканчиваю чат."
    }
