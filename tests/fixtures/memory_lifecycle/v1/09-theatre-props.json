  "messages": [
    {
      "from": "peer",
      "minute": 0,
      "text": "Could we sort the costume cupboard before rehearsal?"
    },
    {
      "from": "owner",
      "minute": 3,
      "text": "Yes, but there is a safety detail first."
    },
    {
      "from": "owner",
      "minute": 6,
      "text": "I am allergic to latex. Please order nitrile gloves for me."
    },
    {
      "from": "assistant",
      "minute": 9,
      "text": "Nitrile gloves for Dara Iliev; noted."
    },
    {
      "from": "peer",
      "minute": 12,
      "text": "I nearly ordered actor gloves for Daria Iliev instead. Different person!"
    },
    {
      "from": "owner",
      "minute": 15,
      "text": "Exactly. Daria is in the cast; I work with the backstage team."
    },
    {
      "from": "owner",
      "minute": 18,
      "text": "The opening remains 2026-09-12 for now."
    },
    {
      "from": "peer",
      "minute": 21,
      "text": "We still need to borrow a dressing mirror."
    },
    {
      "from": "owner",
      "minute": 24,
      "text": "The dance school can lend one, but only after six."
    },
    {
      "from": "assistant",
      "minute": 27,
      "text": "I have the glove requirement and provisional opening date."
    },
    {
      "from": "peer",
      "minute": 30,
      "text": "The old mirror stand is missing a wheel."
    },
    {
      "from": "owner",
      "minute": 33,
      "text": "Put it aside rather than trying to balance it."
    },
    {
      "from": "peer",
      "minute": 36,
      "text": "Should the crown have a ribbon under it?"
    },
    {
      "from": "owner",
      "minute": 39,
      "text": "Ask Daria; it is her costume, not mine."
    },
    {
      "from": "peer",
      "minute": 42,
      "text": "She says the wig covers the fastening."
    },
    {
      "from": "owner",
      "minute": 45,
      "text": "Then leave the crown as it is."
    },
    {
      "from": "assistant",
      "minute": 48,
      "text": "No crown alteration requested."
    },
    {
      "from": "peer",
      "minute": 51,
      "text": "Unrelated: the interval music has been changed."
    },
    {
      "from": "owner",
      "minute": 54,
      "text": "Fine, I am not responsible for the music cues."
    },
    {
      "from": "peer",
      "minute": 57,
      "text": "Where should I put the silver crown this afternoon?"
    },
    {
      "from": "owner",
      "minute": 60,
      "text": "Only this afternoon, leave it on the portable costume rail."
    },
    {
      "from": "peer",
      "minute": 63,
      "text": "I will return it to storage after the run-through."
    },
    {
      "from": "owner",
      "minute": 66,
      "text": "Back to the opening: the venue offered September 19."
    },
    {
      "from": "peer",
      "minute": 69,
      "text": "Is that confirmed, or only an offer?"
    },
    {
      "from": "owner",
      "minute": 72,
      "text": "Only an offer; keep September 12 until I confirm."
    },
    {
      "from": "peer",
      "minute": 75,
      "text": "And which backstage jobs still come to you?"
    },
    {
      "from": "owner",
      "minute": 78,
      "text": "This changed yesterday: I no longer coordinate props."
    },
    {
      "from": "owner",
      "minute": 81,
      "text": "From 2026-09-01 I am the lighting designer. Please send prop questions to Olek."
    },
    {
      "from": "peer",
      "minute": 84,
      "text": "So Daria acts, Olek handles props, and you design lighting?"
    },
    {
      "from": "owner",
      "minute": 87,
      "text": "Yes. Also, the venue just confirmed opening on 2026-09-19; September 12 is cancelled."
    },
    {
      "from": "assistant",
      "minute": 90,
      "text": "The explicit confirmation replaces the earlier provisional date."
    },
    {
      "from": "peer",
      "minute": 93,
      "text": "Good; I will tell the cast after rehearsal."
    }
  ],
